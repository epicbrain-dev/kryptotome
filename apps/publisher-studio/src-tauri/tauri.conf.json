{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "../",
    "distDir": "../"
  },
  "package": {
    "productName": "Kryptotome Publisher Studio",
    "version": "1.1.0"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "category": "DeveloperTool",
      "copyright": "2026 Kryptotome Contributors",
      "identifier": "org.kryptotome.publisherstudio"
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https:;"
    },
    "windows": [
      {
        "title": "Kryptotome Publisher Studio",
        "width": 1180,
        "height": 820,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
