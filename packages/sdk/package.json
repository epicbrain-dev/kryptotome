{
  "name": "@kryptotome/sdk",
  "version": "1.1.0",
  "description": "Client SDK and verification engine for Kryptotome protocol",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./wasm": {
      "types": "./dist/wasm/index.d.ts",
      "import": "./dist/wasm/index.js",
      "default": "./dist/wasm/index.js"
    }
  },
  "scripts": {
    "build": "tsc && node scripts/copy-wasm.mjs",
    "test": "node --test"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.5.4"
  },
  "keywords": [
    "kryptotome",
    "zero-knowledge",
    "verifiable-credentials",
    "ttrpg",
    "offline-first"
  ],
  "license": "Apache-2.0"
}
