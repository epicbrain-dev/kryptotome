{
  "manifest_version": 3,
  "name": "Kryptotome Web VTT Bridge",
  "version": "1.1.0",
  "description": "Zero-knowledge rulebook & compendium injector for Web VTTs (Roll20 & Alchemy RPG) via local vault proofs.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.roll20.net/*",
    "*://*.alchemyrpg.com/*"
  ],
  "background": {
    "service_worker": "dist/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.roll20.net/*"],
      "js": ["dist/roll20.js"],
      "css": ["src/inject.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.alchemyrpg.com/*"],
      "js": ["dist/alchemy.js"],
      "css": ["src/inject.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kryptotome Web VTT Vault",
    "default_icon": "icons/icon-48.png"
  },
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
